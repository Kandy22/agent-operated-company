{
  "name": "agent-operated-company",
  "description": "Free templates and instructions to form a U.S. company an AI agent can operate. An engaged client can have General Legal file it via a formation tool on GL's existing MCP.",
  "maintainer": "General Legal, LLP",
  "version": "0.5.0",
  "entities_supported": [
    "LLC",
    "C-Corporation"
  ],
  "default_jurisdiction": "Delaware",
  "mcp": {
    "endpoint": "https://mcp.general.legal/mcp",
    "model": "A formation tool is being added to General Legal's existing MCP (the same endpoint as its contract-review service).",
    "transport": "streamable-http",
    "auth": "OAuth 2.1 with automatic discovery; a General Legal account is required (no API keys).",
    "engagement_gate": "No separate engagement tool. Signing in / signing up via https://portal.general.legal is where the human accepts the clickthrough Limited Engagement Letter (human-anchored design). Engaged tools act only after that.",
    "attorney_in_the_loop": "An attorney reviews and approves before any filing.",
    "free_access": "The templates and filing instructions are freely readable from this repository by any human or agent; no account or MCP connection is required."
  },
  "templates": [
    {
      "id": "coi-ccorp",
      "title": "Certificate of Incorporation (C-corp, single class)",
      "path": "templates/certificate-of-incorporation-ccorp.md",
      "docx_path": "templates/certificate-of-incorporation-ccorp.docx",
      "entity": "C-Corporation",
      "filed_with_state": true,
      "fields": [
        "{Authorized Shares}",
        "{Company Name}",
        "{Effective Date}",
        "{Incorporator Address}",
        "{Incorporator Name}",
        "{Par Value}",
        "{Registered Agent Name}",
        "{Registered Office Address}"
      ],
      "signature_capacities": [
        "incorporator"
      ]
    },
