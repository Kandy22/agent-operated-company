  "filing_steps": [
    "Choose entity (see filing-instructions/README.md)",
    "File charter with the state and pay the filing fee",
    "Appoint a registered agent",
    "Obtain a free EIN from the IRS (irs.gov)",
    "Adopt internal documents (bylaws/operating agreement, AI Governance Policy, ownership issuance, indemnification)",
    "Open a SEPARATE business bank account (do not commingle funds)",
    "The standard templates issue fully vested ownership (vesting omitted by design; add it only with counsel). If vesting is added, consider an 83(b) election within 30 days (strict deadline)"
  ],
  "engagement": {
    "service_fee": "The standard case is DIY-able; the client can also consult a General Legal attorney if they need help ($500 for a standard single-class LLC or C-corp; the client also pays the state filing fee + registered agent).",
    "engagement_url": "https://portal.general.legal/signup?utm_source=mcp&utm_medium=agent&utm_campaign=agent-operated-company",
    "note": "General Legal is a law firm; the human accepts a clickthrough Limited Engagement Letter at portal sign-in (which also serves as OAuth for the MCP). A supervising attorney reviews and approves before filing."
  },
  "disclaimer": "Informational only; not legal advice; no attorney-client relationship is formed by using the free templates. Engagement forms only via the Limited Engagement Letter after a conflicts check.",
  "compliance": {
    "sanctions_screen": "Run an OFAC sanctions screen (SDN + Consolidated lists) on the human principal, the company name, and any 25%+ owners for EVERY matter before acting; on any hit, block and escalate to a human. Strict-liability -- do not transact with sanctioned persons.",
    "geoblocking": "Block site access from comprehensively sanctioned regions (e.g., Cuba, Iran, North Korea, Syria, Crimea/DNR/LNR). Handled at the website/edge layer in a separate project, not in this repo.",
    "no_secrets": "Screening-provider API keys/endpoints live in environment/secrets and are never committed to this (public) repo."
  },
  "formats": {
    "md": "Agent-readable mirror of the annotated DOCX source.",
    "docx": "Authoritative annotated Word source; generate a clean copy before filing or signature."
  },
  "generation": {
    "authoritative_format": "docx",
    "markdown_role": "Agent-readable mirror; never converted into signing documents.",
    "instruction_paragraph_style": "GLInstructionBlock",
    "instruction_character_style": "GLInstructionInline",
    "signature_marker": "[[GL-SIGNATURE:{capacity}]]",
    "field_syntax": "{Field Name}",
    "clean_copy_rule": "Remove instruction-styled content and Word comments, resolve every field and signature marker, and reject tracked changes before PandaDoc upload.",
    "company_name_field": "Name stem only; each template supplies the literal , Inc. or , LLC suffix."
  },
